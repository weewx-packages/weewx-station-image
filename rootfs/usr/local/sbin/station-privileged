#!/bin/sh
# Copyright (c) 2026 Manuel Hilgert <hilman2@gmail.com>
#
# The only root actions of the station administration, which runs as weewx. The
# sudoers rule in /etc/sudoers.d/station allows this script and nothing else, so
# every argument is checked here.
set -eu
export DEBIAN_FRONTEND=noninteractive
action=${1:-}
[ $# -gt 0 ] && shift

case "$action" in
    weewx-stop)
        # Blocks on purpose: the callers go on to change the database, which WeeWX
        # must have closed by then.
        exec systemctl stop weewx
        ;;
    weewx-start|weewx-restart)
        # WeeWX can wait a long time for the clock, and the caller must not.
        exec systemctl --no-block "${action#weewx-}" weewx
        ;;
    weewx-enable)
        exec systemctl enable weewx
        ;;
    admin-restart)
        # Delayed, so the page can still read how the job that asked for it ended.
        exec systemd-run --quiet --on-active=6 --unit=station-admin-restart \
            systemctl restart station-admin
        ;;
    set-timezone)
        case "${1:-}" in
            *..*|/*|'') echo "Not a time zone" >&2; exit 2 ;;
        esac
        [ -f "/usr/share/zoneinfo/$1" ] || { echo "Not a time zone" >&2; exit 2; }
        exec timedatectl set-timezone "$1"
        ;;
    apt-install)
        for package in "$@"; do
            printf '%s\n' "$package" | grep -Eq '^[a-z0-9][a-z0-9+.-]+$' || {
                echo "Not a package name: $package" >&2; exit 2; }
        done
        apt-get update
        exec apt-get install -y --no-install-recommends -- "$@"
        ;;
    apt-upgrade)
        # The WeeWX package enables and starts WeeWX on every upgrade. On a station
        # whose settings are not saved yet, WeeWX must stay off, because the
        # administration takes an enabled WeeWX for a station that is set up.
        enabled=$(systemctl is-enabled weewx || true)
        apt-get update
        # weewx.conf belongs to the package, and the station has changed it. The
        # upgrade keeps that version and writes the package's merge beside it.
        # A new release may bring a new dependency, which plain upgrade would hold
        # back together with WeeWX.
        status=0
        apt-get upgrade -y --with-new-pkgs -o Dpkg::Options::=--force-confdef \
            -o Dpkg::Options::=--force-confold || status=$?
        if [ "$enabled" = disabled ]; then
            systemctl disable --now weewx
        fi
        exit "$status"
        ;;
    reboot|poweroff)
        exec systemctl --no-block "$action"
        ;;
    *)
        echo "Unknown action: $action" >&2
        exit 2
        ;;
esac
